---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SideStory from '../../components/SideStory.astro';
import { SITE, DESK } from '../../site.config';
import { getCategory, topOf, colorOf, categoryUrl } from '../../lib/categories';
import { getArticles, formatDate, isoDate, readingTime, wordCount, lastModified, authorUrl, type Article } from '../../lib/articles';
import { img, srcset, abs, schemaImages } from '../../lib/images';
import { organization, author as authorSchema, breadcrumbs, IDS } from '../../lib/schema';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { category: topOf(getCategory(article.data.category)).slug, slug: article.id }, props: { article, all: articles } }));
}

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const { title, description, date, category, author, image, imageAlt, imageCredit, tags } = article.data;
const { Content } = await render(article);
const cat = getCategory(category);
const url = new URL(Astro.url.pathname, Astro.site).href;
const top = topOf(cat); // the main category; `cat` may be a subcategory of it
const catUrl = `${SITE.url}${categoryUrl(cat)}`;
const topUrl = `${SITE.url}${categoryUrl(top)}`;
const modified = lastModified(article);
const wasUpdated = modified.getTime() !== date.getTime();
const byUrl = authorUrl(author);
const others = all.filter((a) => a.id !== article.id);
const sameCat = others.filter((a) => a.data.category === category);
const sameTop = others.filter((a) => a.data.category !== category && topOf(getCategory(a.data.category)).slug === top.slug);
const rest = others.filter((a) => topOf(getCategory(a.data.category)).slug !== top.slug);
const related = [...sameCat, ...sameTop, ...rest].slice(0, 4);
const enc = encodeURIComponent;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    '@id': `${url}#article`,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    isPartOf: { '@type': 'WebSite', '@id': IDS.SITE_ID, name: SITE.name, url: `${SITE.url}/` },
    headline: title,
    description,
    inLanguage: SITE.language,
    wordCount: wordCount(article.body),
    thumbnailUrl: abs(img(image, 1200, 675)),
    image: schemaImages(image),
    datePublished: isoDate(date),
    dateModified: isoDate(modified),
    articleSection: top.name,
    ...(tags.length ? { keywords: tags.join(', ') } : {}),
    author: [authorSchema(author)],
    publisher: organization(),
  },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/` },
    { name: top.name, url: topUrl },
    ...(cat.parent ? [{ name: cat.name, url: catUrl }] : []),
    { name: title, url },
  ]),
];
---
<Base title={title} rawTitle description={description} image={img(image, 1200, 675)} imageAlt={imageAlt} type="article" section={top.slug} jsonLd={jsonLd}
  article={{ published: isoDate(date), modified: isoDate(modified), section: top.name, author, authorUrl: byUrl, tags }}>
  <article class="article" style={`--cat:${colorOf(cat)}`}>
    <header class="article-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href={categoryUrl(top)}>{top.name}</a>{cat.parent && <> › <a href={categoryUrl(cat)}>{cat.name}</a></>}</nav>
      <a class="badge badge-link" href={categoryUrl(cat)}>{cat.name}</a>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="byline">
        <span class="by-author">
          <img src="/icon-192.png" width="32" height="32" alt="" loading="lazy" decoding="async" />
          {byUrl ? <a href={byUrl} rel="author">{author}</a> : <span>{author}</span>}
        </span>
        <span>Published <time datetime={isoDate(date)}>{formatDate(date)}</time></span>
        {wasUpdated && <span>Updated <time datetime={isoDate(modified)}>{formatDate(modified)}</time></span>}
        <span>{readingTime(article.body)}</span>
      </div>
    </header>

    <div class="article-layout">
      <div class="article-main">
        <figure class="hero">
          <img src={img(image, 1600, 900)} srcset={srcset(image)} sizes="(max-width: 1000px) calc(100vw - 32px), 800px" width="1600" height="900" alt={imageAlt} loading="eager" fetchpriority="high" />
          {imageCredit && <figcaption>{imageCredit}</figcaption>}
        </figure>

        <div class="share">
          <span class="share-label">Share</span>
          <a href={`https://wa.me/?text=${enc(title + ' ' + url)}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}`} target="_blank" rel="noopener">X</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <button type="button" id="copyLink" data-url={url}>Copy link</button>
        </div>

        <div class="prose"><Content /></div>

        {tags.length > 0 && <ul class="tags" aria-label="Topics">{tags.map((t) => <li>#{t}</li>)}</ul>}

        <p class="note">This article is for general information only and is not financial, investment, medical or legal advice. See our <a href="/disclaimer/">disclaimer</a>.</p>

        {author === DESK.name && (
          <div class="author-box">
            <img src="/icon-192.png" width="64" height="64" alt="" loading="lazy" decoding="async" />
            <div>
              <p class="author-name"><a href={byUrl} rel="author">{DESK.name}</a></p>
              <p class="author-role">{DESK.role}</p>
              <p>{DESK.bio}</p>
              <a class="author-more" href={byUrl}>More from {DESK.name} →</a>
            </div>
          </div>
        )}
      </div>

      <aside class="article-side" aria-label="Related stories and contact">
        {related.length > 0 && (
          <div class="widget">
            <h2 class="widget-title">Related Stories</h2>
            {related.map((a) => <SideStory article={a} />)}
          </div>
        )}
        <div class="widget widget-dark">
          <h2 class="widget-title">Contact the Desk</h2>
          <p>Have a tip, a correction or a question about this story? Send it to our editors.</p>
          <a class="btn" href={`mailto:${SITE.email}?subject=${enc('Re: ' + title)}`}>Email the editors</a>
          <p class="widget-small">{SITE.email}</p>
        </div>
      </aside>
    </div>
  </article>
  <script is:inline>
    (function () {
      var b = document.getElementById('copyLink');
      if (!b || !navigator.clipboard) return;
      b.addEventListener('click', function () {
        navigator.clipboard.writeText(b.dataset.url).then(function () {
          b.textContent = 'Copied';
          setTimeout(function () { b.textContent = 'Copy link'; }, 2000);
        });
      });
    })();
  </script>
</Base>
