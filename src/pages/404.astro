---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="page" style="text-align:center;padding:40px 0">
    <h1>Page not found</h1>
    <p style="color:var(--ink-2)">The page you're looking for has moved or doesn't exist.</p>
    <p><a href="/" style="color:var(--link);font-weight:600">← Back to the front page</a></p>
  </div>
</Base>
