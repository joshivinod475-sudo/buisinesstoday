---
import '../styles/global.css';
import { SITE, DESK } from '../site.config';
import { categoryUrl } from '../lib/categories';
import { getArticles, getSections, articleUrl } from '../lib/articles';
import { abs } from '../lib/images';
import { organization } from '../lib/schema';

interface Props {
  title?: string;
  /** Use the title exactly as given, without adding the site name. */
  rawTitle?: boolean;
  description?: string;
  /** Path or URL of a 1200x675 share image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  article?: { published: string; modified: string; section: string; author: string; authorUrl?: string; tags: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Category slug to highlight in the menu. */
  section?: string;
}
const {
  title, rawTitle = false, description = SITE.description, image, imageAlt, type = 'website',
  article, jsonLd, noindex = false, section,
} = Astro.props;

const brandName = SITE.name;
const fullTitle = title ? (rawTitle ? title : `${title} | ${brandName}`) : `${brandName}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = abs(image ?? '/og-default.jpg');
const ogAlt = imageAlt ?? `${brandName} logo`;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
// Logo: a trailing "today" is shown in the accent colour.
const [, logoA = brandName, logoB = ''] = brandName.match(/^(.*?)(today)$/i) ?? [];
// Headlines for the scrolling "Breaking News" strip: the newest stories.
const breaking = (await getArticles()).slice(0, 8);
// Menu and footer sections come from src/data/categories.json. Categories and
// subcategories with no published stories are left out until they have one.
const sections = await getSections();
const menu = sections.filter((s) => s.cat.menu !== false);
// The subcategory page being viewed, if any (/category/<parent>/<sub>/...).
const subSlug = path.match(/^\/category\/[^/]+\/(?!page\/)([^/]+)\//)?.[1];
const isCategoryHome = (slug: string) => path === `/category/${slug}/`;
const schemas = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []);
// Every page carries the publisher details, so Google can connect stories to the site.
if (!schemas.some((s) => s['@graph'])) schemas.push({ '@context': 'https://schema.org', ...organization() });
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Lets the styles know scripts are on, so the mobile menu can start closed. -->
    <script is:inline>document.documentElement.className += ' js';</script>
    <!-- Light or dark theme, set before the page is drawn so it never flashes the
         wrong colours: the reader's saved choice, otherwise the device setting. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved === 'dark' || (saved !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    <!-- Google tag (Google Analytics / GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TJM2GG8R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="google-site-verification" content="rAW3rqU6x_EAVloKFvAhc8CqZxrWDnViL-polkfqPDQ" />
    <meta name="google-site-verification" content="RBZkIAS2ZtUwa6sW-SHUZjdQuY0AyGdAh8t8m0-nGEg" />
    <meta name="theme-color" content="#0b2545" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap_index.xml" />
    <link rel="alternate" type="application/rss+xml" title={brandName} href="/rss.xml" />

    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? brandName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={ogAlt} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified} />
        <meta property="article:section" content={article.section} />
        {article.authorUrl && <meta property="article:author" content={abs(article.authorUrl)} />}
        <meta name="author" content={article.author} />
        {article.tags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? brandName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="topbar">
        <div class="wrap">
          <span class="today" id="today">&nbsp;</span>
          <span class="topbar-links"><a href="/about/">About Us</a><a href="/editorial-standards/">Editorial Standards</a><a href="/contact/">Contact</a>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch between light and dark">
              <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
              <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </span>
        </div>
      </div>
      <div class="masthead">
        <a class="logo" href="/" aria-label={`${brandName} home`}>
          <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="currentColor"/><rect x="14" y="36" width="8" height="14" rx="2" fill="#fbbf24"/><rect class="bar" x="28" y="26" width="8" height="24" rx="2" fill="#fff"/><rect class="bar" x="42" y="14" width="8" height="36" rx="2" fill="#fff"/></svg>
          <span class="logo-text">{logoA}<em>{logoB}</em></span>
        </a>
        <p class="strapline">{SITE.strapline}</p>
      </div>
      <nav class="nav" id="site-nav" aria-label="Primary">
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Menu</span>
        </button>
        <ul class="nav-list" id="primary-menu">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {menu.map(({ cat: c, children }) => (
            <li class:list={{ 'has-sub': children.length > 0 }}>
              {/* "page" on the category's own page, "true" on its subcategory and story pages: both get the underline. */}
              <a href={categoryUrl(c)} aria-current={section === c.slug ? (isCategoryHome(c.slug) ? 'page' : 'true') : undefined}>{c.name}</a>
              {children.length > 0 && (
                <>
                  <button class="sub-toggle" type="button" aria-expanded="false" aria-haspopup="true" aria-controls={`sub-${c.slug}`} aria-label={`${c.name} topics`}>
                    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <ul class="sub" id={`sub-${c.slug}`}>
                    {children.map((s) => (
                      <li><a href={categoryUrl(s)} aria-current={section === c.slug && subSlug === s.slug ? 'page' : undefined}>{s.name}</a></li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          ))}
        </ul>
      </nav>
      {breaking.length > 0 && (
        <div class="breaking" aria-label="Breaking news">
          <span class="breaking-label">Breaking News</span>
          <div class="breaking-track">
            <!-- The list is printed twice so the scroll loops without a gap. -->
            <div class="breaking-move">
              <ul>
                {breaking.map((a) => <li><a href={articleUrl(a)}>{a.data.title}</a></li>)}
              </ul>
              <ul aria-hidden="true">
                {breaking.map((a) => <li><a href={articleUrl(a)} tabindex="-1">{a.data.title}</a></li>)}
              </ul>
            </div>
          </div>
        </div>
      )}
    </header>

    <main id="main">
      <div class="wrap"><slot /></div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <p class="foot-brand">{logoA}<em>{logoB}</em></p>
            <p>{SITE.description}</p>
            <p>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <nav aria-label="Sections">
            <p class="foot-head">Sections</p>
            <ul>{sections.map(({ cat: c }) => <li><a href={categoryUrl(c)}>{c.name}</a></li>)}</ul>
          </nav>
          <nav aria-label="Company">
            <p class="foot-head">Company</p>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/category/all/">All News</a></li>
              <li><a href={`/author/${DESK.slug}/`}>{DESK.name}</a></li>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/editorial-standards/">Editorial Standards</a></li>
              <li><a href="/contact/">Contact Us</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Use</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
              <li><a href="/rss.xml">RSS Feed</a></li>
            </ul>
          </nav>
        </div>
        <div class="copy">
          <p>© {year} {brandName}. All rights reserved.</p>
          <p><a href="/about/">About</a> · <a href="/privacy-policy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/editorial-standards/#corrections">Corrections</a></p>
        </div>
      </div>
    </footer>
    <script is:inline>
      // Main menu: the mobile "Menu" button, and the subcategory dropdowns
      // (hover on desktop, tap on touch screens, Tab / Enter / Esc on a keyboard).
      (function () {
        var nav = document.getElementById('site-nav');
        if (!nav) return;
        var toggle = nav.querySelector('.nav-toggle');
        var items = nav.querySelectorAll('.has-sub');
        var desktop = window.matchMedia('(min-width: 1101px)');

        function setOpen(li, open) {
          li.classList.toggle('open', open);
          li.querySelector('.sub-toggle').setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        function closeAll(except) {
          items.forEach(function (li) { if (li !== except) { setOpen(li, false); li.classList.remove('closed'); } });
        }

        toggle.addEventListener('click', function () {
          var open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (!open) closeAll();
        });

        items.forEach(function (li) {
          var btn = li.querySelector('.sub-toggle');
          btn.addEventListener('click', function () {
            var open = btn.getAttribute('aria-expanded') !== 'true';
            closeAll(li);
            setOpen(li, open);
            li.classList.toggle('closed', !open); // keeps it shut while the pointer is still over it
          });
          // Desktop: opening on hover or keyboard focus is done in CSS; keep aria-expanded in step.
          li.addEventListener('mouseenter', function () { if (desktop.matches && !li.classList.contains('closed')) btn.setAttribute('aria-expanded', 'true'); });
          li.addEventListener('mouseleave', function () { if (desktop.matches) { setOpen(li, false); li.classList.remove('closed'); } });
          li.addEventListener('focusin', function () { if (desktop.matches && !li.classList.contains('closed')) btn.setAttribute('aria-expanded', 'true'); });
          li.addEventListener('focusout', function (e) {
            if (desktop.matches && !li.contains(e.relatedTarget)) { setOpen(li, false); li.classList.remove('closed'); }
          });
          li.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') return;
            e.stopPropagation();
            setOpen(li, false);
            li.classList.add('closed');
            btn.focus();
          });
        });

        // Esc closes the mobile menu; a click or tap outside closes everything.
        nav.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && nav.classList.contains('open')) {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
        document.addEventListener('click', function (e) {
          if (nav.contains(e.target)) return;
          closeAll();
          if (nav.classList.contains('open')) { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }
        });
      })();
    </script>
    <script is:inline>
      // Light / dark switch. The choice is remembered on this device; until one
      // is made, the page follows the device setting, including when it changes.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        var meta = document.querySelector('meta[name="theme-color"]');
        function apply(theme) {
          root.setAttribute('data-theme', theme);
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1216' : '#0b2545');
          if (btn) btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
        apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
        if (btn) btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          apply(next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
        var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
        if (mq && mq.addEventListener) mq.addEventListener('change', function (e) {
          var saved = null;
          try { saved = localStorage.getItem('theme'); } catch (err) {}
          if (saved !== 'dark' && saved !== 'light') apply(e.matches ? 'dark' : 'light');
        });
      })();
    </script>
    <script is:inline>
      document.getElementById('today').textContent = new Date().toLocaleDateString('en-IN', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      });
    </script>
  </body>
</html>
