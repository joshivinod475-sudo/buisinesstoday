---
import '../styles/global.css';
import { SITE, CATEGORIES } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description = SITE.description, image, type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const [first, ...rest] = SITE.name.split(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="rAW3rqU6x_EAVloKFvAhc8CqZxrWDnViL-polkfqPDQ" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#0b2545" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="wrap">
        <span id="today">&nbsp;</span>
        <a href="/about/">About</a>
      </div>
    </div>
    <header class="masthead">
      <a class="logo" href="/" aria-label={`${SITE.name} home`}>
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="currentColor"/><rect x="14" y="36" width="8" height="14" rx="2" fill="#fbbf24"/><rect x="28" y="26" width="8" height="24" rx="2" fill="#fff"/><rect x="42" y="14" width="8" height="36" rx="2" fill="#fff"/></svg>
        <span class="logo-text">{first}<em>{rest.length ? ' ' + rest.join(' ') : ''}</em></span>
      </a>
      <p class="tagline">{SITE.tagline}</p>
    </header>
    <nav class="nav" aria-label="Sections">
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Latest</a></li>
        {CATEGORIES.map((c) => (
          <li><a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>{c.name}</a></li>
        ))}
      </ul>
    </nav>

    <main id="main">
      <div class="wrap"><slot /></div>
    </main>

    <footer>
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <div class="foot-brand">{first}<em>{rest.length ? ' ' + rest.join(' ') : ''}</em></div>
            <p>{SITE.description}</p>
            <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <div>
            <h4>Sections</h4>
            <ul>{CATEGORIES.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/about/">About us</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy-policy/">Privacy policy</a></li>
              <li><a href="/terms/">Terms of use</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
        </div>
        <div class="copy">© {year} {SITE.name}. All rights reserved.</div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('today').textContent = new Date().toLocaleDateString('en-IN', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
      });
    </script>
  </body>
</html>
