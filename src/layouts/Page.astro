---
import Base from './Base.astro';
interface Props { title: string; description: string; updated?: string; noindex?: boolean }
const { title, description, updated, noindex } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <div class="page">
    <h1>{title}</h1>
    {updated && <p class="meta">Last updated: {updated}</p>}
    <div class="prose" style="margin-top:20px"><slot /></div>
  </div>
</Base>
