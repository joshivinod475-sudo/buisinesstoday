---
import { getCategory, colorOf } from '../lib/categories';
import { formatDate, isoDate, readingTime, articleUrl, type Article } from '../lib/articles';
import { img, srcset } from '../lib/images';

interface Props { article: Article; excerpt?: boolean }
const { article, excerpt = true } = Astro.props;
const { title, description, date, category, image, imageAlt } = article.data;
const cat = getCategory(category);
const url = articleUrl(article);
---
<article class="card" style={`--cat:${colorOf(cat)}`}>
  <a href={url} class="card-art" tabindex="-1" aria-hidden="true">
    <span class="badge">{cat.name}</span>
    <img src={img(image, 800, 450)} srcset={srcset(image)} sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 900px) 50vw, 380px" width="800" height="450" alt={imageAlt} loading="lazy" decoding="async" />
  </a>
  <h3><a href={url}>{title}</a></h3>
  {excerpt && <p>{description}</p>}
  <div class="meta"><time datetime={isoDate(date)}>{formatDate(date)}</time><span>{readingTime(article.body)}</span></div>
</article>
