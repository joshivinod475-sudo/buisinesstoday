Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Sitemaps and the RSS feed are sent as "application/xml; charset=utf-8"
AddType application/xml .xml
AddCharset utf-8 .xml

RewriteEngine On

# Never expose the git folder or repo files (Hostinger's Git deploy clones .git into public_html)
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^(README\.md|\.gitignore)$ - [R=404,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old section addresses -> new sections (permanent redirects)
RewriteRule ^category/personal-finance/?$ /category/markets/personal-finance/ [L,R=301]
RewriteRule ^category/startups/?$ /category/smes/ [L,R=301]
RewriteRule ^sitemap-0\.xml$ /sitemap.xml [L,R=301]

# "Health & Wellness" was renamed "Healthcare" (slug health -> healthcare).
# Covers the category page, its paginated pages (/page/2/ ...) and every story under /health/.
RewriteRule ^category/health(/page/[0-9]+)?/?$ /category/healthcare$1/ [L,R=301]
RewriteRule ^health/(.+)$ /healthcare/$1 [L,R=301]

# Old article addresses (/articles/name/) -> /category/name/.
# The list is filled in by scripts/make-redirects.mjs every time the site is built.
# ARTICLE-REDIRECTS
RewriteRule ^articles/abdul-el-sayed-michigan-senate-win-us-midterms-2026/?$ /world/abdul-el-sayed-michigan-senate-win-us-midterms-2026/ [L,R=301]
